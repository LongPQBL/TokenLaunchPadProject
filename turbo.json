{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"], "env": ["DEPLOYMENT", "API_PROXY_TARGET"] },
    "typecheck": { "dependsOn": ["^build"], "env": ["DATABASE_URL"] },
    "test": { "dependsOn": ["^build"], "env": ["DATABASE_URL"] }
  }
}
