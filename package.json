{
  "name": "vezta-launchpad",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": { "node": ">=22" },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "eslint apps packages tools --no-error-on-unmatched-pattern",
    "test": "turbo run test",
    "build": "turbo run build",
    "verify:quote": "cd examples/evm-flow && pnpm --silent verify:quote"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
