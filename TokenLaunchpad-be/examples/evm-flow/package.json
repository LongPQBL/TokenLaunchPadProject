    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "react": "^19.2.0",
    "@types/react": "^19.2.0",
    "wagmi": "^3.7.0",
    "@tanstack/react-query": "^5.90.0",
    "lightweight-charts": "^5.1.0",
    "@reown/appkit": "^1.8.0",
    "@reown/appkit-adapter-wagmi": "^1.8.0"
  }
