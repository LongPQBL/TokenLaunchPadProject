{
  "name": "evm-flow-example",
  "private": true,
  "type": "module",
  "description": "Runnable viem examples for the Vezta launchpad contracts: create, quote, buy, sell, graduate, migrate, claim fees.",
  "scripts": {
    "flow": "tsx src/run-all.ts",
