# Every variable read by apps/api, apps/bot, apps/indexer and packages/app-db, in one place.
# Copy to TokenLaunchpad-be/.env and fill it in — it is git-ignored, never commit it.
# `pnpm dev` / `pnpm start` in each of those four packages loads it automatically (via dotenv-cli); a variable
# already exported in the shell wins over this file, never the other way round.
# TokenLaunchpad-be/scripts/demo-sepolia.sh and e2e.sh set what they need themselves and do not read this file,
# except for PINATA_JWT and BOT_PRIVATE_KEY (the two real secrets), which they read from here too.

# --- Database (api, indexer, app-db) -------------------------------------------------------------
# The user must be in the URL for Prisma (it does not fall back to the OS user like psql does).
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/vezta_dev

# --- Deployment (api, bot, indexer) --------------------------------------------------------------
# Which TokenLaunchpad-be/packages/deployments/<name>.json to read (the launchpad's address). "local" is
# written by scripts/local-chain.sh.
DEPLOYMENT=local

# --- Chain RPC (bot; api optionally) -------------------------------------------------------------
# JSON-RPC of the chain. The bot needs it; the API only to verify smart-contract wallet signatures (ERC-1271)
# and to tell the admin page the chain's head.
# RPC_URL=http://127.0.0.1:8545

# --- Chain RPC (indexer) ---------------------------------------------------------------------------
# The same RPC as above, in Ponder's own naming: one per chain, suffixed with the chain id. On a real network
# also set the _FALLBACK variable to a second provider: the first backfill reads a lot of logs and one
# endpoint will rate-limit it.
PONDER_RPC_URL_11155111=http://127.0.0.1:8545
# PONDER_RPC_URL_11155111_FALLBACK=
# The schema Ponder writes its tables to. Needed by `pnpm start:views`, which also keeps the stable
# `launchpad` views schema the API reads. A new name for a fresh index; the same name resumes.
PONDER_SCHEMA=indexer

# --- Redis (bot publishes; api subscribes) ---------------------------------------------------------
# Carries live updates (trades, comments, moderation) between processes. Without it the bot still migrates,
# and pages poll instead.
# REDIS_URL=redis://127.0.0.1:6379

# --- API server ------------------------------------------------------------------------------------
# Not PORT: Ponder (among other tools) treats a plain PORT as an override that always wins over its own --port flag,
# and this file is read by every backend package, so a plain PORT here would silently steal the indexer's port too.
API_PORT=3001
# The web app's origin (no path): the sign-in message names it, so a signature made for another site is refused.
WEB_ORIGIN=http://localhost:3000
# Origins allowed to call the API from a browser, comma separated. A wildcard is refused: sessions are cookies.
CORS_ORIGINS=http://localhost:3000
# "true" only behind a reverse proxy that sets X-Forwarded-For: rate limits then count the real client, not the proxy.
# TRUST_PROXY=false
# The indexer's own HTTP address (Ponder), so the admin page can say how far behind it is.
# INDEXER_URL=http://localhost:42069

# --- Token images and metadata, IPFS (api) ---------------------------------------------------------
# The ONE host the metadata resolver may contact. Only ipfs:// URIs are ever fetched, through this gateway.
# ipfs.io/dweb.link no longer serve path-gateway requests server-side (429: browser-only service worker gateway
# now) — gateway.pinata.cloud is the default since this project already holds a Pinata account for pinning.
IPFS_GATEWAY_URL=https://gateway.pinata.cloud
# "pinata" pins for real; "fake" pins nothing (tests and local play; refused when NODE_ENV=production).
# PINNER=pinata
# SECRET. A Pinata API key (JWT) whose scopes include Files: write. Server only: never a NEXT_PUBLIC_ variable.
PINATA_JWT=

# --- Admin (api) -------------------------------------------------------------------------------------
# Comma-separated TRADING-wallet addresses (the address the header's wallet menu shows, not the main wallet)
# that may use /admin.
# ADMIN_ADDRESSES=

# --- Migration bot's own wallet ------------------------------------------------------------------------
# SECRET. It only ever pays gas (a little ETH is enough). Make one for it (`cast wallet new`): never a wallet
# that holds anything else, and never a well-known test key (the bot refuses those).
BOT_PRIVATE_KEY=
# How often, in milliseconds, the bot looks for new blocks.
# POLL_MS=4000
# How often, in minutes, the bot re-scans for curves that filled without it noticing.
# CATCH_UP_MINUTES=10
# The most blocks one eth_getLogs may cover. Set it to what your RPC plan allows (Alchemy's free plan: 10);
# unset, thousands.
# LOG_RANGE_BLOCKS=10
