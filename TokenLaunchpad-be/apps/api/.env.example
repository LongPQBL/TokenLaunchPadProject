# Backend API (Hono). Copy to .env and fill in. .env is git-ignored: never commit it.
# The API reads process.env and nothing else: export these before `pnpm start`, or start it with `node --env-file=.env`.
# (TokenLaunchpad-be/scripts/demo-sepolia.sh and e2e.sh set them for you.)

# --- Required ----------------------------------------------------------------------------------
# The user must be in the URL for Prisma (it does not fall back to the OS user like psql does).
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/vezta_dev
# Which TokenLaunchpad-be/packages/deployments/<name>.json to read (the launchpad's address, for the holders list).
DEPLOYMENT=local

# --- Server ------------------------------------------------------------------------------------
PORT=3001
# The web app's origin (no path): the sign-in message names it, so a signature made for another site is refused.
WEB_ORIGIN=http://localhost:3000
# Origins allowed to call the API from a browser, comma separated. A wildcard is refused: sessions are cookies.
CORS_ORIGINS=http://localhost:3000
# "true" only behind a reverse proxy that sets X-Forwarded-For: rate limits then count the real client, not the proxy.
# TRUST_PROXY=false

# --- Chain and services (all optional) -----------------------------------------------------------
# JSON-RPC of the chain: verifies signatures of smart-contract wallets (ERC-1271) and tells the admin page the chain's head.
# RPC_URL=
# Redis: carries live updates (trades, comments, moderation) between processes. Without it pages poll instead.
# REDIS_URL=redis://127.0.0.1:6379
# The indexer's own HTTP address (Ponder), so the admin page can say how far behind it is.
# INDEXER_URL=http://localhost:42069

# --- Token images and metadata (IPFS) ------------------------------------------------------------
# The ONE host the metadata resolver may contact. Only ipfs:// URIs are ever fetched, through this gateway.
IPFS_GATEWAY_URL=https://ipfs.io
# "pinata" pins for real; "fake" pins nothing (tests and local play; refused when NODE_ENV=production).
# PINNER=pinata
# SECRET. A Pinata API key (JWT) whose scopes include Files: write. Server only: never a NEXT_PUBLIC_ variable.
PINATA_JWT=

# --- Admin ---------------------------------------------------------------------------------------
# Comma-separated TRADING-wallet addresses (the address the header's wallet menu shows, not the main wallet) that may use /admin.
# ADMIN_ADDRESSES=
