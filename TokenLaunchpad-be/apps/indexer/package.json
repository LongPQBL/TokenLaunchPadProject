{
  "name": "@vezta/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ponder dev",
    "start": "ponder start",
    "start:views": "ponder start --schema $PONDER_SCHEMA --views-schema launchpad",
    "codegen": "ponder codegen",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "fixture:same-block": "tsx test/fixtures/same-block.ts",
    "fixture:fresh": "tsx test/fixtures/fresh.ts",
    "typecheck": "DEPLOYMENT=example ponder codegen > /dev/null && tsc --noEmit"
  },
  "dependencies": {
    "@vezta/abi": "workspace:*",
    "@vezta/deployments": "workspace:*",
    "@vezta/shared": "workspace:*",
    "hono": "^4.6.0",
    "ponder": "0.17.10",
    "viem": "^2.47.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-orm": "0.41.0",
    "postgres": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
