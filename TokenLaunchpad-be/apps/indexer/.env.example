# Which TokenLaunchpad-be/packages/deployments/<name>.json to read. "local" is written by scripts/local-chain.sh.
DEPLOYMENT=local

# One per chain, suffixed with the chain id. On a real network also set the _FALLBACK variable to a
# second provider: the first backfill reads a lot of logs and one endpoint will rate-limit it.
PONDER_RPC_URL_11155111=http://127.0.0.1:8545
# PONDER_RPC_URL_11155111_FALLBACK=

# Postgres. Ponder writes its own schema; see start:views for the stable `launchpad` views schema.
DATABASE_URL=postgresql://localhost:5432/vezta_dev
# The schema Ponder writes its tables to. Needed by `pnpm start:views`, which also keeps the stable `launchpad` views schema the API reads.
# A new name for a fresh index; the same name resumes.
PONDER_SCHEMA=indexer
