# The user must be in the URL: Prisma's engine does not fall back to the OS user the way psql, pg and
# postgres.js do, and fails with P1010 "User was denied access" otherwise.
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/vezta_dev

# Tests refuse to run unless the database name ends in _test (they call deleteMany).
# DATABASE_URL=postgresql://YOUR_USER@localhost:5432/vezta_test
