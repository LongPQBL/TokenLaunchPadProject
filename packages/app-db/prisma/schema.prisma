generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Scoped to `app` only, so Prisma migrations can never touch the schema Ponder owns (spec §4.3).
  schemas  = ["app"]
}

model AppUser {
  address   String    @id // lower-case 0x…, from SIWE
  // Unique ignoring case by an index on lower(username) that Prisma cannot model (see the profiles_and_bans migration), so
  // it is not marked @unique here: the database is the authority, and a duplicate is refused there.
  username  String?
  avatarUri String?   @map("avatar_uri")
  /// When set, the person's comments stop being served and they cannot post. Their rows are kept.
  bannedAt  DateTime? @map("banned_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at")
  comments  Comment[]
  reports   Report[]
  favorites Favorite[]

  @@map("app_user")
  @@schema("app")
}

model TokenMetadata {
  chainId     Int       @map("chain_id")
  token       String
  uri         String
  name        String?
  symbol      String?
  description String?
  imageUri    String?   @map("image_uri")
  imageCdnUrl String?   @map("image_cdn_url")
  socials     Json      @default("{}")
  status      String    @default("pending") // ok | pending | invalid | hidden
  attempts    Int       @default(0) // resolve attempts so far (spec §4.4)
  nextAttempt DateTime? @map("next_attempt")
  fetchedAt   DateTime? @map("fetched_at")
  /// Who hid the token and when: an audit trail, since nothing can be removed from the chain, only from the app.
  hiddenBy    String?   @map("hidden_by")
  hiddenAt    DateTime? @map("hidden_at") @db.Timestamptz(3)

  @@id([chainId, token])
  @@index([status, nextAttempt])
  @@map("token_metadata")
  @@schema("app")
}

model Comment {
  id        BigInt   @id @default(autoincrement())
  chainId   Int      @map("chain_id")
  token     String
  author    String
  body      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      AppUser  @relation(fields: [author], references: [address])

  @@index([chainId, token, createdAt(sort: Desc)])
  @@map("comment")
  @@schema("app")
}

model Report {
  id        BigInt   @id @default(autoincrement())
  chainId   Int      @map("chain_id")
  token     String
  reporter  String
  reason    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      AppUser  @relation(fields: [reporter], references: [address])

  // A partial unique index (see the one_open_report_each migration) keeps one unsettled report per person per token.
  @@index([resolved, createdAt])
  @@map("report")
  @@schema("app")
}

/// A token a person has starred, kept on the account so it follows them to any device. One row for each person and token.
model Favorite {
  chainId   Int      @map("chain_id")
  address   String // the person, lower-case
  token     String // lower-case
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      AppUser  @relation(fields: [address], references: [address])

  @@id([chainId, address, token])
  @@index([address, chainId, createdAt(sort: Desc)])
  @@map("favorite")
  @@schema("app")
}

/// What a moderator did, kept apart from the things it was done to: a token row forgets who hid it once it is unhidden, and a
/// ban leaves nothing but a time. One row for each change that actually happened, never for a repeat that changed nothing.
model ModerationEvent {
  id        BigInt   @id @default(autoincrement())
  chainId   Int      @map("chain_id")
  /// token_hide | token_unhide | comment_hide | comment_unhide | user_ban | user_unban
  action    String
  /// A token address, a comment id or a user address, whichever the action is about.
  target    String
  actor     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([chainId, createdAt(sort: Desc)])
  @@map("moderation_event")
  @@schema("app")
}

/// A sign-in challenge. Single use: consuming it deletes it, so a signature can never be replayed.
model SiweNonce {
  nonce     String   @id
  address   String // lower-case 0x…: the nonce is only good for the address it was issued to
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("siwe_nonce")
  @@schema("app")
}

/// A signed-in browser. The cookie holds only the random id; everything else is looked up here, so a session can be
/// revoked by deleting its row (a ban, a logout on another device).
model Session {
  id        String   @id
  address   String // lower-case 0x…
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([address])
  @@index([expiresAt])
  @@map("session")
  @@schema("app")
}

/// One counted hit against a rate limit. Kept in Postgres so the limit holds across API instances without another service.
model RateHit {
  id     BigInt   @id @default(autoincrement())
  bucket String // which limit: "upload", "nonce", ...
  key    String // who: an address or an IP
  at     DateTime @default(now()) @db.Timestamptz(3)

  @@index([bucket, key, at])
  @@map("rate_hit")
  @@schema("app")
}
